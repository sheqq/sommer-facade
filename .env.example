# Copy this file to .env (ignored by Git).
# MongoDB Atlas: use the connection string from Atlas > Connect > Drivers.
# Replace the placeholders with your Atlas database user, password, and cluster host.
MONGODB_URI=mongodb+srv://<database-user>:<password>@<cluster-host>/sommer?retryWrites=true&w=majority&appName=sommer-facade

# Generate a random secret and use the same value in the bot's environment.
API_KEY=replace-with-a-random-secret

# Public API origin; set this to your deployed domain outside local development.
API_BASE_URL=http://localhost:8080
